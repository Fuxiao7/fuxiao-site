[Unit]
Description=Fuxiao Submission API
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=fuxiao
Group=fuxiao
WorkingDirectory=/srv/fuxiao/api
EnvironmentFile=/srv/fuxiao/api/.env
ExecStart=/usr/bin/java -Xms256m -Xmx1024m -jar /srv/fuxiao/api/app.jar
Restart=always
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
