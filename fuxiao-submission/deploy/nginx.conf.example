# 生产环境 Nginx 示例
# 假设：
#   管理台构建产物在 /var/www/fuxiao-admin
#   后端运行在 127.0.0.1:8080
#   博客静态图片在 /var/www/fuxiao-blog/public/media
# 请把 server_name 与证书换成自己的。

server {
    listen 80;
    server_name admin.fuxiao.art;

    root /var/www/fuxiao-admin;
    index index.html;

    client_max_body_size 25m;

    # 前端（history 路由）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端接口
    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # 后台上传的图片
    location /uploads/ {
        proxy_pass http://127.0.0.1:8080/uploads/;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public";
    }

    # 博客原有图片：直接指向博客的 public/media
    location /media/ {
        alias /var/www/fuxiao-blog/public/media/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # 可选：给静态资源加长缓存
    location ~* \.(?:js|css|woff2?|png|jpe?g|webp|svg)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public";
    }
}
