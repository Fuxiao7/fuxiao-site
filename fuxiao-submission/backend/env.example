# 后端环境变量参考（Spring Boot 直接读取环境变量，不会自动加载本文件）
#
# 上线前必须修改：
#   JWT_SECRET        至少 32 字节的随机字符串
#   DB_PASSWORD       数据库密码
#   ADMIN_INIT_PASSWORD  仅首次建库时生效
#
# SERVER_PORT=8080
# DB_URL=jdbc:mysql://127.0.0.1:3306/fuxiao_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
# DB_USERNAME=root
# DB_PASSWORD=fuxiao123
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# JWT_EXPIRE_HOURS=72
# UPLOAD_DIR=./uploads
# ADMIN_INIT_PASSWORD=fuxiao@2026
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
